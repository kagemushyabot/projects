---
import { buildHomeChaosCollageItems } from '../utils/homeChaosCollage';
import { assetUrl, workExperienceHref } from '../utils/paths';

const items = buildHomeChaosCollageItems();
const workHref = workExperienceHref();

function imgSrc(src: string) {
  return src.startsWith('http') ? src : assetUrl(src);
}

const initial = items[0];
const initialSrc = initial ? imgSrc(initial.src) : '';
---

<div class="home-flip" data-home-flip data-page-flip>
  <div class="home-flip-stage" data-flip-stage>
    <div class="home-flip-viewport">
      <div class="home-flip-stack" data-flip-stack>
        <div class="home-flip-under" data-flip-under aria-hidden="true">
          <div class="home-flip-art">
            <img data-flip-img-under alt="" decoding="async" width="640" height="400" />
          </div>
        </div>
        <div class="home-flip-sheet" data-flip-sheet data-axis="y">
          <div class="home-flip-face home-flip-face--front" data-flip-face="front">
            <div class="home-flip-art">
              {
                initial && (
                  <img
                    data-flip-img-front
                    src={initialSrc}
                    alt=""
                    decoding="async"
                    width="640"
                    height="400"
                  />
                )
              }
            </div>
          </div>
          <div class="home-flip-face home-flip-face--back" data-flip-face="back" aria-hidden="true">
            <div class="home-flip-art">
              <img data-flip-img-back alt="" decoding="async" width="640" height="400" />
            </div>
          </div>
        </div>
      </div>
      <div class="home-flip-spine" aria-hidden="true"></div>
    </div>
    <p class="home-flip-project" data-flip-title>
      {initial?.title ?? ''}
    </p>
  </div>

  <div class="home-flip-ui">
    <p class="home-flip-count" aria-live="polite">
      {items.length} projects · page flip preview
    </p>
    <div class="home-flip-controls">
      <button type="button" class="home-flip-manual" data-flip-prev aria-label="Previous project">
        Prev
      </button>
      <button type="button" class="home-flip-pause" data-flip-pause aria-pressed="false">
        Pause motion
      </button>
      <button type="button" class="home-flip-manual" data-flip-next aria-label="Next project">
        Next
      </button>
    </div>
    <a class="home-flip-all" href={workHref}>
      View full work experience
      <span aria-hidden="true"> →</span>
    </a>
  </div>
</div>

<script is:inline define:vars={{ flipItems: items.map((i) => ({ ...i, src: imgSrc(i.src) })) }}>
  (function () {
    var root = document.querySelector('[data-page-flip]');
    var sheet = document.querySelector('[data-flip-sheet]');
    var under = document.querySelector('[data-flip-under]');
    var imgFront = document.querySelector('[data-flip-img-front]');
    var imgBack = document.querySelector('[data-flip-img-back]');
    var imgUnder = document.querySelector('[data-flip-img-under]');
    var titleEl = document.querySelector('[data-flip-title]');
    var pauseBtn = document.querySelector('[data-flip-pause]');
    var prevBtn = document.querySelector('[data-flip-prev]');
    var nextBtn = document.querySelector('[data-flip-next]');
    if (!root || !sheet || !under || !imgFront || !imgBack || !imgUnder || !titleEl || !flipItems.length) return;

    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var FLIP_DURATION_MS = 300;
    var FLIP_INTERVAL_MS = 3000;
    var paused = false;
    var flipping = false;
    var cadenceTimer = 0;
    var cadenceAlternate = false;
    var cadenceStarts = [];
    var order = flipItems.map(function (_, i) {
      return i;
    });
    var seqPtr = 0;

    var FLIP_RIGHT = {
      id: 'right-y',
      axis: 'y',
      origin: '100% 50%',
      end: 'rotateY(-176deg)',
    };
    var FLIP_LEFT = {
      id: 'left-y',
      axis: 'y',
      origin: '0% 50%',
      end: 'rotateY(176deg)',
    };

    root.dataset.flipDurationMs = String(FLIP_DURATION_MS);
    root.dataset.flipIntervalMs = String(FLIP_INTERVAL_MS);

    function shuffle(arr) {
      for (var i = arr.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var t = arr[i];
        arr[i] = arr[j];
        arr[j] = t;
      }
      return arr;
    }
    shuffle(order);

    function projectAt(seqIndex) {
      return flipItems[order[((seqIndex % order.length) + order.length) % order.length]];
    }

    function preloadAll() {
      flipItems.forEach(function (item) {
        var im = new Image();
        im.decoding = 'async';
        im.src = item.src;
      });
    }
    preloadAll();

    function setFace(img, project) {
      img.src = project.src;
      img.alt = project.title;
    }

    function pickMode() {
      cadenceAlternate = !cadenceAlternate;
      return cadenceAlternate ? FLIP_RIGHT : FLIP_LEFT;
    }

    function restingLayout() {
      under.classList.remove('home-flip-under--active');
      sheet.classList.remove('home-flip-sheet--turned', 'home-flip-sheet--animating');
      sheet.style.transform = 'none';
      sheet.style.transitionDuration = '';
    }

    function applyResting(seqIndex) {
      var current = projectAt(seqIndex);
      setFace(imgFront, current);
      setFace(imgUnder, current);
      titleEl.textContent = current.title;
      restingLayout();
      sheet.dataset.resting = 'true';
      root.dataset.currentProject = current.projectId;
      root.dataset.currentTitle = current.title;
      root.dataset.stageCovered = 'single';
    }

    function prepareBack(seqIndex) {
      setFace(imgBack, projectAt(seqIndex));
    }

    seqPtr = 0;
    applyResting(seqPtr);
    prepareBack(seqPtr + 1);

    function snapAfterTurn(nextSeq) {
      seqPtr = ((nextSeq % order.length) + order.length) % order.length;
      var current = projectAt(seqPtr);
      setFace(imgFront, current);
      setFace(imgUnder, current);
      titleEl.textContent = current.title;
      sheet.style.transition = 'none';
      restingLayout();
      requestAnimationFrame(function () {
        sheet.style.transition = '';
      });
      sheet.dataset.resting = 'true';
      root.dataset.currentProject = current.projectId;
      root.dataset.currentTitle = current.title;
      root.dataset.lastFlipMs = String(FLIP_DURATION_MS);
      prepareBack(seqPtr + 1);
      flipping = false;
      root.dataset.stageCovered = 'single';
    }

    function runFlip(direction) {
      if (flipping) return;
      flipping = true;
      var startAt = performance.now();
      cadenceStarts.push(startAt);
      if (cadenceStarts.length > 24) cadenceStarts.shift();
      root.dataset.lastFlipStart = String(startAt);
      sheet.dataset.resting = 'false';
      var nextSeq = seqPtr + (direction < 0 ? -1 : 1);
      var outgoing = projectAt(seqPtr);
      var incoming = projectAt(nextSeq);
      var mode = pickMode();

      setFace(imgFront, outgoing);
      setFace(imgUnder, outgoing);
      setFace(imgBack, incoming);
      under.classList.add('home-flip-under--active');

      sheet.dataset.axis = mode.axis;
      sheet.dataset.flipMode = mode.id;
      sheet.style.transformOrigin = mode.origin;
      sheet.style.setProperty('--flip-ms', String(FLIP_DURATION_MS));
      root.dataset.lastFlipMode = mode.id;
      root.dataset.stageCovered = 'under+sheet';

      sheet.classList.add('home-flip-sheet--animating');
      sheet.style.transform = 'none';
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          sheet.classList.add('home-flip-sheet--turned');
          sheet.style.transform = mode.end;
        });
      });

      window.setTimeout(function () {
        snapAfterTurn(nextSeq);
      }, FLIP_DURATION_MS + 20);
    }

    function startCadence() {
      window.clearInterval(cadenceTimer);
      if (reduced || paused) return;
      cadenceTimer = window.setInterval(function () {
        if (!paused && !flipping) runFlip(1);
      }, FLIP_INTERVAL_MS);
    }

    function stopCadence() {
      window.clearInterval(cadenceTimer);
      cadenceTimer = 0;
    }

    if (reduced) {
      root.classList.add('home-flip--reduced');
      if (pauseBtn) pauseBtn.hidden = true;
      prevBtn.hidden = false;
      nextBtn.hidden = false;
      prevBtn.addEventListener('click', function () {
        if (flipping) return;
        seqPtr = (seqPtr + order.length - 1) % order.length;
        applyResting(seqPtr);
        prepareBack(seqPtr + 1);
      });
      nextBtn.addEventListener('click', function () {
        if (flipping) return;
        seqPtr = (seqPtr + 1) % order.length;
        applyResting(seqPtr);
        prepareBack(seqPtr + 1);
      });
      return;
    }

    prevBtn.hidden = true;
    nextBtn.hidden = true;

    if (pauseBtn) {
      pauseBtn.addEventListener('click', function () {
        paused = !paused;
        pauseBtn.setAttribute('aria-pressed', paused ? 'true' : 'false');
        pauseBtn.textContent = paused ? 'Resume motion' : 'Pause motion';
        root.classList.toggle('home-flip--paused', paused);
        if (paused) stopCadence();
        else startCadence();
      });
    }

    startCadence();

    root.runFlipForTest = function (dir) {
      runFlip(dir || 1);
    };
    root.getCadenceStarts = function () {
      return cadenceStarts.slice();
    };
  })();
</script>
