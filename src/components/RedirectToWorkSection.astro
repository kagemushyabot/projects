---
import { workExperienceHref, type WorkExperienceSection } from '../utils/paths';

interface Props {
  section: WorkExperienceSection;
  label: string;
}

const { section, label } = Astro.props;
const url = workExperienceHref(section);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0;url=${url}`} />
    <link rel="canonical" href={url} />
    <title>{label} · Jun Nagaoka</title>
    <script is:inline define:vars={{ url }}>
      if (typeof location !== 'undefined') location.replace(url);
    </script>
  </head>
  <body>
    <p>
      <a href={url}>Continue to work experience — {label}</a>
    </p>
  </body>
</html>
