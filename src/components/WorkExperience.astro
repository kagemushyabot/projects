---
import HomeStillSlideshow from './HomeStillSlideshow.astro';
import { withBase, workExperienceHref } from '../utils/paths';

const resumeHref = withBase('/resume/');
const workHref = workExperienceHref();
---

<section class="work-xp" aria-labelledby="work-xp-heading">
  <header class="work-xp-head reveal">
    <p class="work-xp-kicker">Selected work</p>
    <h2 id="work-xp-heading" class="work-xp-title">
      <a href={workHref}>Work experience</a>
    </h2>
    <p class="work-xp-lead">
      One project at a time from the unified gallery — same names and media as the full work experience
      page, with a physical page-turn preview.
    </p>
  </header>

  <div class="work-xp-flip reveal" style="--reveal-delay: 80ms">
    <HomeStillSlideshow />
  </div>

  <aside class="resume-tease reveal" style="--reveal-delay: 200ms">
    <p class="resume-tease-label">Also on this site</p>
    <a class="resume-tease-link" href={resumeHref}>
      <span class="resume-tease-title">resume</span>
      <span class="resume-tease-hint">Professional experience · 2027 PDF</span>
    </a>
  </aside>
</section>
