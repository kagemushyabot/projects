---
import { buildPortfolioGallery, EVIL_EYE_PANEL_ID } from '../utils/portfolioGallery';
import { assetUrl } from '../utils/paths';
import PortfolioVideoModal from './PortfolioVideoModal.astro';

const { projects } = buildPortfolioGallery();

function thumbSrc(youtubeId: string) {
  return `https://img.youtube.com/vi/${youtubeId}/mqdefault.jpg`;
}

/** Panels that use the Water reference hero frame (1 still + 1 video). */
const PAIR_HERO_IDS = new Set([
  'facebook-spaces',
  'google-play-music-panorama-festival-nyc-2016',
  'water-is-life-hidden-dangers-vr-campaign',
]);
---

<div class="portfolio-gallery" id="work-main">
  <ul class="gallery-grid" role="list">
    {
      projects.map((project, index) => {
        const maxImages = project.layout === 'feature' ? 14 : project.layout === 'wide' ? 10 : 8;
        const visibleImages = project.images.slice(0, maxImages);
        const extraImages = project.images.length - visibleImages.length;
        const isPairHero =
          PAIR_HERO_IDS.has(project.id) ||
          (visibleImages.length === 1 && project.videos.length === 1 && project.videos.length > 0);
        const isMixed = visibleImages.length > 0 && project.videos.length > 0;
        const layout = project.evilEyeLayout;

        return (
        <li
          id={project.id}
          class:list={[
            'gallery-item',
            'reveal',
            `gallery-item--${project.layout}`,
            project.id === EVIL_EYE_PANEL_ID && 'gallery-item--evil-eye',
          ]}
          style={`--reveal-delay: ${(index % 10) * 35}ms`}
        >
          <article class="gallery-card">
            <header class="gallery-card-head">
              <h2 class="gallery-card-title">{project.title}</h2>
              {project.credit && <p class="gallery-card-credit">{project.credit}</p>}
            </header>

            {layout ? (
              <div class="gallery-card-media gallery-card-media--evil-eye" data-media-grid data-mixed-panel>
                <div class="gallery-evil-eye-spotlight">
                  <figure class="gallery-image gallery-image--still gallery-image--hero-frame">
                    <img
                      src={assetUrl(layout.spotlight.src)}
                      alt={layout.spotlight.alt}
                      loading="lazy"
                      decoding="async"
                    />
                  </figure>
                </div>

                <div class="gallery-evil-eye-pair gallery-evil-eye-pair--pearl" data-media-pair>
                  <div class="gallery-evil-eye-pair-still">
                    <figure class="gallery-image gallery-image--still gallery-image--hero-frame">
                      <img
                        src={assetUrl(layout.pearl.still.src)}
                        alt={layout.pearl.still.alt}
                        loading="lazy"
                        decoding="async"
                      />
                    </figure>
                    <p class="gallery-evil-eye-caption">{layout.pearl.still.captionText}</p>
                  </div>
                  <div class="gallery-evil-eye-pair-video">
                    <button
                      type="button"
                      class="gallery-video-thumb"
                      data-video-open
                      data-youtube-id={layout.pearl.youtubeId}
                      data-video-title={layout.pearl.videoAlt}
                      aria-label={`Play video: ${layout.pearl.videoAlt}`}
                    >
                      <img
                        src={thumbSrc(layout.pearl.youtubeId)}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        width="320"
                        height="180"
                      />
                      <span class="gallery-video-badge" aria-hidden="true">
                        <svg class="gallery-video-play-icon" viewBox="0 0 24 24" focusable="false">
                          <path d="M8 5v14l12-7z" fill="currentColor" />
                        </svg>
                      </span>
                    </button>
                  </div>
                </div>

                <div class="gallery-evil-eye-pair gallery-evil-eye-pair--on-ice" data-media-pair>
                  <div class="gallery-evil-eye-pair-still">
                    <figure class="gallery-image gallery-image--still gallery-image--hero-frame">
                      <img
                        src={assetUrl(layout.onIce.still.src)}
                        alt={layout.onIce.still.alt}
                        loading="lazy"
                        decoding="async"
                      />
                    </figure>
                    <p class="gallery-evil-eye-caption">{layout.onIce.still.captionText}</p>
                  </div>
                  <div class="gallery-evil-eye-pair-video">
                    <button
                      type="button"
                      class="gallery-video-thumb"
                      data-video-open
                      data-youtube-id={layout.onIce.youtubeId}
                      data-video-title={layout.onIce.videoAlt}
                      aria-label={`Play video: ${layout.onIce.videoAlt}`}
                    >
                      <img
                        src={thumbSrc(layout.onIce.youtubeId)}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        width="320"
                        height="180"
                      />
                      <span class="gallery-video-badge" aria-hidden="true">
                        <svg class="gallery-video-play-icon" viewBox="0 0 24 24" focusable="false">
                          <path d="M8 5v14l12-7z" fill="currentColor" />
                        </svg>
                      </span>
                    </button>
                  </div>
                </div>
              </div>
            ) : (
              (project.videos.length > 0 || project.images.length > 0) && (
                <div
                  class:list={[
                    'gallery-card-media',
                    isPairHero && 'gallery-card-media--pair-hero',
                    isMixed && 'gallery-card-media--mixed',
                  ]}
                  data-media-grid
                  data-mixed-panel={isMixed ? '' : undefined}
                >
                  {
                    visibleImages.map((img) => (
                      <figure class="gallery-image gallery-image--still gallery-image--hero-frame">
                        <img
                          src={assetUrl(img.src)}
                          alt={img.alt}
                          loading="lazy"
                          decoding="async"
                        />
                      </figure>
                    ))
                  }
                  {
                    project.videos.map((video) => (
                      <button
                        type="button"
                        class="gallery-video-thumb"
                        data-video-open
                        data-youtube-id={video.youtubeId}
                        data-video-title={project.title}
                        aria-label={`Play video: ${project.title}`}
                      >
                        <img
                          src={thumbSrc(video.youtubeId)}
                          alt=""
                          loading="lazy"
                          decoding="async"
                          width="320"
                          height="180"
                        />
                        <span class="gallery-video-badge" aria-hidden="true">
                          <svg class="gallery-video-play-icon" viewBox="0 0 24 24" focusable="false">
                            <path d="M8 5v14l12-7z" fill="currentColor" />
                          </svg>
                        </span>
                      </button>
                    ))
                  }
                  {
                    extraImages > 0 && (
                      <p class="gallery-more-media" aria-label={`${extraImages} more images in this project`}>
                        +{extraImages}
                      </p>
                    )
                  }
                </div>
              )
            )}

            {
              project.notes.length > 0 && (
                <ul class="gallery-card-notes">
                  {project.notes.map((note) => (
                    <li>{note}</li>
                  ))}
                </ul>
              )
            }
          </article>
        </li>
        );
      })
    }
  </ul>
</div>

<PortfolioVideoModal />
