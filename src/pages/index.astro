---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
import { withBase } from '../utils/paths';

const works = [
  { num: '01', href: withBase('/custom/'), label: 'custom', hint: 'AR / VR / film' },
  { num: '02', href: withBase('/images/'), label: 'images', hint: 'Laser scan portfolio' },
  { num: '03', href: withBase('/animation/'), label: 'animation', hint: 'TD · rigging · cinematics' },
  { num: '04', href: withBase('/resume/'), label: 'resume', hint: '2027 PDF' },
];
---

<BaseLayout title="Jun Nagaoka" current="home">
  {
    siteConfig.launched ? (
      <section class="home-hero">
        <h1 class="home-type">
          <span class="line-jun">JUN</span>
          <span class="line-nagaoka">NAGAOKA</span>
        </h1>
        <p class="home-role">Lead / Senior 3D Artist · 3D Generalist · Technical Artist</p>
        <ul class="work-index">
          {
            works.map((w) => (
              <li>
                <a href={w.href}>
                  <span class="num">{w.num}</span>
                  <span class="label">{w.label}</span>
                  <span class="hint">{w.hint}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    ) : (
      <section class="wip-hero" aria-labelledby="wip-heading">
        <h1 id="wip-heading" class="home-type">
          <span class="line-jun">JUN</span>
          <span class="line-nagaoka">NAGAOKA</span>
        </h1>
        <p class="wip-status">
          <span lang="ja">準備中</span>
          <span class="wip-sep" aria-hidden="true">·</span>
          <span>work in progress</span>
        </p>
        <p class="wip-note">Portfolio site is being updated. Full work index will appear here after launch.</p>
      </section>
    )
  }
</BaseLayout>
