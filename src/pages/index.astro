---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import WorkExperience from '../components/WorkExperience.astro';
import HomeMotion from '../components/HomeMotion.astro';
import { siteConfig } from '../config/site';
import { homeSummary } from '../data/homeWork';
---

<BaseLayout title="Jun Nagaoka" current="home">
  {
    siteConfig.launched ? (
      <>
        <HomeHero summary={homeSummary} />
        <WorkExperience />
        <HomeMotion />
      </>
    ) : (
      <section class="wip-hero" aria-labelledby="wip-heading">
        <h1 id="wip-heading" class="home-type">
          <span class="line-jun">JUN</span>
          <span class="line-nagaoka">NAGAOKA</span>
        </h1>
        <p class="wip-status">
          <span lang="ja">準備中</span>
          <span class="wip-sep" aria-hidden="true">·</span>
          <span>work in progress</span>
        </p>
        <p class="wip-note">Portfolio site is being updated. Full work index will appear here after launch.</p>
      </section>
    )
  }
</BaseLayout>

<style is:global>
  @import '../styles/home.css';
</style>
