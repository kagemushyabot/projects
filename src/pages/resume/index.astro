---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../utils/paths';

const pdfHref = withBase('/assets/Jun_Nagaoka_Resume_2027.pdf');
const pdfDownloadName = 'Jun_Nagaoka_Resume_2027.pdf';
---

<BaseLayout title="resume" current="resume">
  <article class="resume-page" id="resume-main">
    <div class="resume-header">
      <h1>JUN NAGAOKA</h1>
      <p class="meta">
        Lead / Senior 3D Artist · 3D Generalist · Technical Artist<br />
        Honolulu, HI · 415-314-0625 ·
        <a href="mailto:oshigoto4jun@gmail.com">oshigoto4jun@gmail.com</a>
      </p>
    </div>

    <a class="resume-download" href={pdfHref} download={pdfDownloadName}>Download PDF (2027)</a>

    <section class="resume-section">
      <h2>Professional Summary</h2>
      <p class="resume-summary">
        Lead 3D Artist and Technical Artist with deep experience in AR/VR and real-time production,
        including animation, character rigging, modeling, lighting, rendering, and compositing. Builds
        and manages asset pipelines for real-time assets, provides technical support to artists, and
        collaborates closely with art directors and engineers. Career credits include commercial AR
        applications, VR storytelling, game cinematics, and exhibition work.
      </p>
    </section>

    <section class="resume-section">
      <h2>Core Skills</h2>
      <ul>
        <li>3D Production: Modeling, texturing, character animation, character rigging, lighting, rendering, previs</li>
        <li>Maya</li>
        <li>After Effects, Illustrator, Photoshop</li>
        <li>AI tools: Claude, Cursor, ChatGPT, Grok Bot</li>
        <li>Technical / Pipeline: Asset and production pipeline development; technical support for artists</li>
        <li>
          Leadership: Lead artist and lead animator roles; supervising artists on animation, modeling, and
          texturing; collaboration with engineers and outsourcing partners
        </li>
        <li>Languages: English and Japanese (bilingual)</li>
      </ul>
    </section>

    <section class="resume-section">
      <h2>Professional Experience</h2>

      <div class="resume-job">
        <h3>Lead 3D Artist · Tactic Studio, San Francisco</h3>
        <p class="dates">May 2016 – November 2026</p>
        <ul>
          <li>
            <strong class="resume-accent-name">Splattic development</strong>: As an artist with no programming
            background, built this AR/VR/XR workflow web app using AI coding tools. Supports glTF, 3DGS, 4DGS,
            USD, and FBX; enables quick previews for
            directors and clients as AR/VR/XR experiences or HTML pages; and generates JSON and JavaScript files
            for engineering handoff.
          </li>
          <li>Lead 3D art production for branded AR applications.</li>
          <li>
            Selected projects: <strong class="resume-accent-name">Coca-Cola</strong> Winter AR app;{' '}
            <strong class="resume-accent-name">Jack Daniel&apos;s</strong> AR app;{' '}
            <strong class="resume-accent-name">Jim Beam</strong> AR app; Treasury Wine Estates (
            <strong class="resume-accent-name">19 Crimes</strong>,{' '}
            <strong class="resume-accent-name">Cali by Snoop Dogg</strong>,{' '}
            <strong class="resume-accent-name">Universal Monsters Halloween</strong> and other Living Wine Labels AR
            apps); many more AR and VR projects.
          </li>
        </ul>
      </div>

      <div class="resume-job">
        <h3>3D Generalist / TD · SPY POST, San Francisco</h3>
        <p class="dates">February 2016 – May 2016</p>
        <ul>
          <li>Automobile commercial project: animation, lighting, rendering, and compositing.</li>
        </ul>
      </div>

      <div class="resume-job">
        <h3>3D Generalist / TD · Swordfish, San Francisco</h3>
        <p class="dates">January 2016 – February 2016</p>
        <ul>
          <li>Commercial projects for HTC 10 smartphone and HTC Vive: animation, lighting, rendering, and compositing.</li>
        </ul>
      </div>

      <div class="resume-job">
        <h3>3D Generalist / TD · Evil Eye Pictures, San Francisco</h3>
        <p class="dates">February 2015 – December 2015</p>
        <ul>
          <li>
            Contributed to animated VR shorts for Google Spotlight Stories. Layout animation, scene setup,
            character rigging, modeling assets and environments; coordination with an outsourcing company on
            character models and rigging; technical support for artists and production needs.
          </li>
          <li>
            <strong class="resume-accent-name">Pearl</strong> (directed by Patrick Osborne): 3D production on the Spotlight Stories slate.
            Film:{' '}
            <span class="resume-accent-nomination"
              >Academy Award nominee, Best Animated Short Film (89th Oscars / 2017 ceremony)</span
            >
            —
            <a href="https://www.oscars.org/oscars/ceremonies/2017" target="_blank" rel="noopener noreferrer"
              >oscars.org</a
            >.
          </li>
          <li>
            <strong class="resume-accent-name">On Ice</strong> (directed by Shannon Tindle): 3D production support on the Spotlight Stories
            slate. Film:{' '}
            <span class="resume-accent-nomination"
              >Annie Award nominee, Best Animated Short Subject (43rd Annie Awards / 2016)</span
            >
            —
            <a
              href="https://www.cgw.com/Press-Center/News/2015/Annie-Awards-Nominees-Announced.aspx"
              target="_blank"
              rel="noopener noreferrer">nominee list</a
            >.
          </li>
        </ul>
      </div>

      <div class="resume-job">
        <h3>Senior Artist · Insight Digital, Emeryville, CA</h3>
        <p class="dates">October 2014 – November 2014</p>
        <ul>
          <li>
            <strong class="resume-accent-name">Mission to the Deep</strong> — MBARI exhibition at{' '}
            <strong class="resume-accent-name">Monterey Bay Aquarium</strong>: compositing in NUKE and After Effects,
            rotoscoping, 3D modeling and texturing.
          </li>
        </ul>
      </div>

      <div class="resume-job">
        <h3>Senior Artist · Ntropic, San Francisco</h3>
        <p class="dates">June 2014 – October 2014</p>
        <ul>
          <li>
            Lighting and rendering with V-Ray for commercial projects; VR and AR R&amp;D in Unity. Selected work:
            modeling, lighting, and rendering for <strong class="resume-accent-name">Apple Watch</strong> premiere
            presentation; lighting and rendering for Nest international commercial.
          </li>
        </ul>
      </div>

      <div class="resume-job">
        <h3>Senior Artist · DeNA West, San Francisco</h3>
        <p class="dates">January 2014 – June 2014</p>
        <ul>
          <li>
            Model review and fixes; character rigging and animation in Maya; created character asset integration
            pipeline with Unity. Also contributed to Marvel Mighty Heroes.
          </li>
          <li>
            <strong class="resume-accent-name">Blood Brothers</strong> 2 (mobile app): particle FX in Unity.
          </li>
          <li>
            <strong class="resume-accent-name">Transformers: Age of Extinction</strong> (mobile app): character rigging
            and animation.
          </li>
        </ul>
      </div>
    </section>

    <section class="resume-section">
      <h2>Earlier Experience</h2>

      <div class="resume-job">
        <h3>Senior Artist · SPY POST, San Francisco</h3>
        <p class="dates">June 2013 – August 2013</p>
        <ul>
          <li>Character rigger and animator for game cinematic (Sony PlayStation title undisclosed).</li>
        </ul>
      </div>

      <div class="resume-job">
        <h3>Lead Animator · Floathybrid Entertainment, San Francisco</h3>
        <p class="dates">2010 – 2013</p>
        <ul>
          <li>
            Studio founded by Academy Award–winning VFX designer <strong class="resume-accent-name">John Gaeta</strong>;
            early Microsoft Kinect incubation team
            member working with prototype Kinect products.
          </li>
          <li>
            Worked directly with the art director on previs animation for prototype Kinect games; collaborated with
            engineers to deliver models, textures, character rigs, and animation for Unity and Unreal.
          </li>
          <li>
            Created particle FX and shader materials in-engine; created and managed asset pipelines; assisted other
            artists.
          </li>
          <li>
            Projects: prototype Kinect games for Microsoft; Escape Plan (PlayStation Vita); G.E. Interactive “Hologram”
            exhibit; UI/UX visualization for iPad apps; technical previs for McDonald&apos;s, Pepsi, Amana, and others.
          </li>
        </ul>
      </div>

      <div class="resume-job">
        <h3>Senior Artist · Insight Digital, Emeryville</h3>
        <p class="dates">2008 – 2010</p>
        <ul>
          <li>
            All-aspect production: modeling, texturing, animation, camera layout, and rendering; laser-scan / point
            cloud and image-based modeling; high-resolution photographic texturing; on-location laser scanning; data
            management and pipeline R&amp;D.
          </li>
          <li>
            Projects: <strong class="resume-accent-name">Trésors engloutis du Nil</strong> (French TV);{' '}
            <strong class="resume-accent-name">Tales of Maya Skies</strong> (Chabot Space &amp; Science Center);{' '}
            <strong class="resume-accent-name">Ramesseum Panel</strong> (French government site displays);{' '}
            <strong class="resume-accent-name">Avila Portal</strong> reassembly with 3D scan geometry (USF);
            projection-animation preproduction for the{' '}
            <strong class="resume-accent-name">National Academy for the Performing Arts</strong> (Trinidad and Tobago).
          </li>
        </ul>
      </div>

      <div class="resume-job">
        <h3>Senior TD · Black Point Studios, San Francisco</h3>
        <p class="dates">2005 – 2008</p>
        <ul>
          <li>
            Lead animator across CG production (modeling, texturing, character rigging, lighting, rendering,
            compositing); supervised artists on animation, modeling, and texturing; supervised motion capture
            sessions; managed production pipeline.
          </li>
          <li>
            Credits: <strong class="resume-accent-name">Iron Man</strong> cinematics (Secret Level);{' '}
            <strong class="resume-accent-name">Blacksite: Area 51</strong> and{' '}
            <strong class="resume-accent-name">Stranglehold</strong> (Midway);{' '}
            <strong class="resume-accent-name">WWE SmackDown 2007/2008</strong> (THQ);{' '}
            <strong class="resume-accent-name">Eragon</strong> (Stormfront Studios);{' '}
            <strong class="resume-accent-name">James Bond: From Russia with Love</strong> (EA);{' '}
            <strong class="resume-accent-name">Gods and Heroes</strong> (Perpetual Entertainment).
          </li>
        </ul>
      </div>

      <div class="resume-job">
        <h3>Senior Artist · Mondo Media (Mondo Studios), San Francisco</h3>
        <p class="dates">2003 – 2005</p>
        <ul>
          <li>
            Animator, lighting artist, compositor, and character rigger. Projects:{' '}
            <strong class="resume-accent-name">James Bond: Everything or Nothing</strong> (EA) cinematics;{' '}
            <strong class="resume-accent-name">Age of Empires III</strong> cinematics (Microsoft Ensemble Studios;
            AI.Implant).
          </li>
        </ul>
      </div>

      <div class="resume-job">
        <h3>Senior Artist · Robot of Mars, Berkeley</h3>
        <p class="dates">2002 – 2003</p>
        <ul>
          <li>Animation, lighting, compositing, and character rigging for 3D ride film Robot of Mars.</li>
        </ul>
      </div>
    </section>

    <section class="resume-section">
      <h2>Education</h2>
      <ul>
        <li>MFA, Computer Animation — Academy of Art College</li>
        <li>BFA, Photography — Academy of Art College</li>
      </ul>
    </section>
  </article>
</BaseLayout>
