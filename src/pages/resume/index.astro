---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../utils/paths';

const pdfHref = withBase('/assets/Jun_Nagaoka_Resume_2027_v8.pdf');
---

<BaseLayout title="resume" current="resume">
  <article class="resume-page" id="resume-main">
    <header class="resume-header">
      <h1>JUN NAGAOKA</h1>
      <p class="resume-lead">Lead / Senior 3D Artist · 3D Generalist · Technical Artist</p>
      <p class="meta">
        Honolulu, HI · 415-314-0625 ·
        <a href="mailto:oshigoto4jun@gmail.com">oshigoto4jun@gmail.com</a>
      </p>
    </header>

    <p class="resume-web-note">
      Condensed web resume (screen/print). Full chronology and older roles:
      <a href={pdfHref} download>Jun_Nagaoka_Resume_2027_v8.pdf</a> — the downloadable PDF is
      <strong>not</strong> identical to this one-page layout.
    </p>

    <div class="resume-download-row">
      <a class="resume-download" href={pdfHref} download>Download PDF (2027 v8)</a>
    </div>

    <section class="resume-section resume-section--tight">
      <h2>Summary</h2>
      <p class="resume-prose">
        Lead / Senior 3D Artist and Technical Artist — AR/VR, real-time production, exhibition work;
        bilingual English / Japanese.
      </p>
    </section>

    <section class="resume-section resume-section--tight">
      <h2>Skills</h2>
      <ul class="resume-skills">
        <li>Maya</li>
        <li>After Effects, Illustrator, Photoshop</li>
        <li>AI tools: Claude, Cursor, ChatGPT, Grok Bot</li>
      </ul>
    </section>

    <section class="resume-section resume-spotlight">
      <h2>Recent focus</h2>

      <div class="resume-spot resume-spot--tactic">
        <h3>Tactic Studio, San Francisco</h3>
        <p class="dates">Lead 3D Artist · May 2016 – November 2026</p>
        <p class="resume-prose">
          Lead 3D art on branded AR applications and studio VR work; asset and production pipeline
          support for artists; collaboration with art directors and engineers.
        </p>
      </div>

      <div class="resume-spot resume-spot--splattic">
        <h3>Splattic <span class="resume-spot-sub">(in development · Tactic Studio)</span></h3>
        <p class="resume-prose">
          As an artist with <strong>no programming background</strong>, built this AR/VR/XR workflow web
          app using <strong>AI coding tools</strong> (not an “AI features” product). Supports glTF, 3DGS,
          4DGS, USD, and FBX; quick previews for directors and clients; JSON/JavaScript for engineering
          handoff.
        </p>
      </div>

      <div class="resume-spot resume-spot--evil-eye">
        <h3>Evil Eye Pictures, San Francisco</h3>
        <p class="dates">3D Generalist / TD · February 2015 – December 2015</p>
        <p class="resume-prose">
          Google Spotlight Stories: layout animation, scene setup, character rigging, modeling for assets and
          environments; coordination with outsourcing on character models and rigging; technical support for
          artists and production.
        </p>

        <div class="resume-film-honors" role="note" aria-labelledby="resume-film-honors-heading">
          <h4 id="resume-film-honors-heading">Short-film honors (the films, not personal awards)</h4>
          <p class="resume-film-disclaimer">
            Nominations below are for the <strong>animated short films</strong> Jun contributed to — not
            individual Academy or Annie Awards presented to Jun Nagaoka.
          </p>
          <ul class="resume-film-list">
            <li>
              <strong>Pearl</strong> (dir. Patrick Osborne) —
              <a href="https://www.oscars.org/oscars/ceremonies/2017" target="_blank" rel="noopener noreferrer"
                >Oscar nominee, Best Animated Short (89th / 2017)</a
              >
            </li>
            <li>
              <strong>On Ice</strong> (dir. Shannon Tindle) —
              <a
                href="https://www.cgw.com/Press-Center/News/2015/Annie-Awards-Nominees-Announced.aspx"
                target="_blank"
                rel="noopener noreferrer"
                >Annie nominee, Best Animated Short Subject (43rd / 2016)</a
              >
            </li>
          </ul>
        </div>
      </div>
    </section>

    <section class="resume-section resume-section--tight">
      <h2>Selected credits</h2>
      <p class="resume-prose resume-prose--muted">Project · role (compact; see PDF for full dates)</p>
      <ul class="resume-credits">
        <li><span class="credit-project">Branded AR / VR</span> — Lead 3D art (Living Wine Labels, Coca-Cola, Jack Daniel&apos;s, Jim Beam, and related Tactic work)</li>
        <li><span class="credit-project">Facebook Spaces · Google Next Keynote 2017 · Water Is Life VR</span> — Tactic Studio production</li>
        <li><span class="credit-project">Mission to the Deep</span> — Compositing, roto, 3D modeling/texturing · Insight Digital</li>
        <li><span class="credit-project">Blood Brothers 2 · Transformers · Marvel Mighty Heroes</span> — Rigging, animation, VFX · DeNA West</li>
        <li><span class="credit-project">HTC 10 / Vive · SPY POST auto spot</span> — Animation, L/R/comp · Swordfish / SPY POST</li>
        <li><span class="credit-project">Apple Watch premiere · Nest commercial</span> — Modeling, lighting, rendering · Ntropic</li>
        <li><span class="credit-project">Escape Plan · Kinect prototypes · laser-scan heritage</span> — Previs, pipelines, on-location scans · Floathybrid / Insight Digital</li>
        <li><span class="credit-project">Earlier game cinematics</span> — Rig/anim/supervision · Black Point, Mondo Media, Robot of Mars (PDF for titles)</li>
      </ul>
    </section>

    <section class="resume-section resume-section--tight">
      <h2>Education</h2>
      <ul class="resume-education">
        <li>MFA, Computer Animation — Academy of Art College</li>
        <li>BFA, Photography — Academy of Art College</li>
      </ul>
    </section>
  </article>
</BaseLayout>
