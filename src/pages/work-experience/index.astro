---
import BaseLayout from '../../layouts/BaseLayout.astro';
import presentation from '../../content/presentation.html?raw';
import images from '../../content/images.html?raw';
import movies from '../../content/movies.html?raw';
import { rewriteImportedHtml, workExperienceHref } from '../../utils/paths';

const jumpLinks = [
  { id: 'custom' as const, label: 'custom', hint: 'AR / VR / film' },
  { id: 'images' as const, label: 'images', hint: 'Laser scan portfolio' },
  { id: 'animation' as const, label: 'animation', hint: 'TD · rigging · cinematics' },
];

const sections = [
  { id: 'custom' as const, label: 'custom', html: rewriteImportedHtml(presentation) },
  { id: 'images' as const, label: 'images', html: rewriteImportedHtml(images) },
  { id: 'animation' as const, label: 'animation', html: rewriteImportedHtml(movies) },
];
---

<BaseLayout title="work experience" current="work-experience">
  <header class="work-page-head">
    <p class="work-page-kicker">Portfolio</p>
    <h1 class="work-page-title">work experience</h1>
    <p class="work-page-lead">
      Commercial AR/VR, heritage laser-scan modeling, and real-time animation — all project media and
      embeds from the migrated portfolio.
    </p>
    <nav class="work-page-jump" aria-label="Work sections">
      <ul>
        {
          jumpLinks.map((link, i) => (
            <li>
              <a href={workExperienceHref(link.id)}>
                <span class="work-page-jump-num" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="work-page-jump-label">{link.label}</span>
                <span class="work-page-jump-hint">{link.hint}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </header>

  {
    sections.map((section, index) => (
      <section id={section.id} class="work-page-section" aria-labelledby={`${section.id}-heading`}>
        <h2 id={`${section.id}-heading`} class="work-page-section-title">
          <span class="work-page-section-num" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          {section.label}
        </h2>
        <div class="wp-content" set:html={section.html} />
      </section>
    ))
  }
</BaseLayout>

<style is:global>
  @import '../../styles/work-experience.css';
</style>
